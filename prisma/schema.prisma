generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CLIENT

  @@map("user_roles")
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED

  @@map("project_statuses")
}

enum QuoteStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  COMPLETED

  @@map("quote_statuses")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CLIENT)
  phone     String?
  image     String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes  Quote[]
  reviews Review[]
  blogs   Blog[]

  @@index([email])
  @@index([isDeleted])
  @@map("users")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@index([isDeleted])
  @@map("services")
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String
  category    String
  location    String
  image       String?
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  reviews Review[]

  @@index([serviceId])
  @@index([status])
  @@index([isDeleted])
  @@map("projects")
}

model Blog {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  excerpt   String?
  image     String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([isDeleted])
  @@map("blogs")
}

model Quote {
  id        String      @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String?
  budget    String?
  status    QuoteStatus @default(PENDING)
  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([isDeleted])
  @@map("quotes")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([isDeleted])
  @@map("reviews")
}
